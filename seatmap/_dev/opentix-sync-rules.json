{
  "schemaVersion": 1,
  "description": "Rules for regenerating Friends of Opus Formosa static OPENTIX seat maps. OPENTIX remains the source of truth for seats that are not matched by Friends VIP rules. Friends VIP rules have highest priority and override any OPENTIX section, price, status, youth, reserved, unavailable, or excluded-seat data. Do not store OPENTIX preview codes in this file; use GitHub Actions secrets named in previewCodeSecret.",
  "rulePrecedence": [
    {
      "order": 1,
      "source": "OPENTIX",
      "appliesTo": "all fetched seats, sections, prices, youth seats, reserved seats, unavailable seats, and excluded seats"
    },
    {
      "order": 2,
      "source": "Friends VIP overrides",
      "appliesTo": "any seat matched by sectionOverrides.match.sectionIds or sectionOverrides.match.seatSelectors",
      "effect": "override OPENTIX data with the rule display name, kind, price, color, and source"
    }
  ],
  "fetch": {
    "programPreviewUrl": "https://csm.api.opentix.life/programs/{programId}/preview?code={previewCode}",
    "eventSeatsUrl": "https://csm.api.opentix.life/events/{eventId}/seats",
    "svgUrlSource": "programPreview.eventVenues[0].events[].seatSvgUrl"
  },
  "output": {
    "json": "assets/opentix/{eventId}-seats.json",
    "svg": "assets/opentix/{eventId}-seatmap.svg",
    "html": "seatmap/opentix/{eventId}.html"
  },
  "displayDefaults": {
    "vipStroke": "#5c420d",
    "reservedStroke": "#766f66",
    "publicStroke": "#333333",
    "reservedUnknownColor": "#c8c2b6"
  },
  "fallbacks": {
    "seatsOnlySection": {
      "name": "保留席／不可公開銷售",
      "kind": "reserved-unknown",
      "price": null,
      "color": "#c8c2b6",
      "source": "opentix-seats-only"
    }
  },
  "githubActions": {
    "schedule": "*/20 * * * *",
    "failureMode": "keep-last-generated-files",
    "commitMessage": "Update OPENTIX seat map snapshots"
  },
