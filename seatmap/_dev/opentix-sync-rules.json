{
  "schemaVersion": 1,
  "description": "Rules for regenerating Friends of Opus Formosa static OPENTIX seat maps. OPENTIX admin seat data remains the source of truth for seats that are not matched by Friends VIP rules. Friends VIP rules have highest priority and override any OPENTIX section, price, status, youth, reserved, unavailable, or excluded-seat data. Do not store OPENTIX credentials or tokens in this file; use local environment variables or GitHub Actions secrets.",
  "rulePrecedence": [
    {
      "order": 1,
      "source": "OPENTIX",
      "appliesTo": "all fetched seats, sections, prices, youth seats, reserved seats, unavailable seats, and excluded seats"
    },
    {
      "order": 2,
      "source": "Friends VIP overrides",
      "appliesTo": "any seat matched by sectionOverrides.match.sectionIds or sectionOverrides.match.seatSelectors",
      "effect": "override OPENTIX data with the rule display name, kind, price, color, and source"
    },
    {
      "order": 3,
      "source": "Friends taken seat markers",
      "appliesTo": "any Friends VIP seat matched by seatStatusOverrides.match.seatSelectors",
      "effect": "keep the Friends VIP style and add a taken marker so the seat is visibly crossed out"
    },
    {
      "order": 4,
      "source": "OPENTIX availability markers",
      "appliesTo": "public OPENTIX seats only",
      "effect": "if a public seat's OPENTIX status is no longer available, keep its public ticket-section style and add a taken marker"
    }
  ],
  "fetch": {
    "adminSeatJsonUrl": "https://opt.api.opentix.life/seats/seatjsonurl?eventId={eventId}&disableShowError=true",
    "adminSectionSeatsUrl": "https://opt.api.opentix.life/sections/seats?eventId={eventId}&parentSeatingChartId={parentSeatingChartId}&disableShowError=true",
    "publicSeatStatusUrl": "https://csm.api.opentix.life/events/{eventId}/seats?parentSeatingChartId={parentSeatingChartId}",
    "cognitoUrl": "https://cognito-idp.ap-northeast-1.amazonaws.com/",
    "cognitoClientId": "18gl53c4lq4a2tcp76il3ghqft",
    "adminLoginUrl": "https://opt.console.opentix.life/organizer/index.html#/login"
  },
  "output": {
    "json": "assets/opentix/{eventId}-seats.json",
    "svg": "assets/opentix/{eventId}-seatmap.svg",
    "html": "seatmap/opentix/{eventId}.html"
  },
  "displayDefaults": {
    "vipStroke": "#5c420d",
    "reservedStroke": "#766f66",
    "publicStroke": "#333333",
    "takenMarkStroke": "#2f2417",
    "reservedUnknownColor": "#c8c2b6"
  },
  "fallbacks": {
    "seatsOnlySection": {
      "name": "保留席／不可公開銷售",
      "kind": "reserved-unknown",
      "price": null,
      "color": "#c8c2b6",
      "source": "opentix-seats-only"
    }
  },
  "githubActions": {
    "schedule": "*/20 * * * *",
    "failureMode": "keep-last-generated-files",
    "commitMessage": "Update OPENTIX seat map snapshots"
  },
  "publicSeatStatusOverlay": {
    "enabled": true,
    "source": "OPENTIX public seats API",
    "effect": "Use public OPENTIX seat status as the availability source because it updates sold/unavailable seats more reliably than the admin sections/seats response. Seat sections, prices, and SVG still come from the admin API."
  },
  "opentixAvailabilityMarkers": {
    "enabled": true,
    "appliesToKinds": [
      "public"
    ],
    "availableStatuses": [
      0,
      "0"
    ],
    "unknownStatusMeansAvailable": true,
    "display": {
      "label": "OPENTIX 已售出／不可售",
      "source": "opentix-availability-marker",
      "note": "公開販售座位若 OPENTIX 狀態不再是可售，維持原票區樣式並以叉叉標示。"
    }
  },
